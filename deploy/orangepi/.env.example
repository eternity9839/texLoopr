# Copy to .env on the Pi (never commit real secrets).
# Generate:
#   openssl rand -base64 24
#   openssl rand -hex 32

DEMO_USER=demo
DEMO_PASSWORD=CHANGE_ME_openssl_rand_base64_24
SESSION_SECRET=CHANGE_ME_openssl_rand_hex_32
SESSION_TTL_SEC=604800
# true behind Tailscale HTTPS; set false only for plain http://127.0.0.1 smoke tests
COOKIE_SECURE=true

POSTGRES_USER=texlooper
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_base64_24
POSTGRES_DB=texlooper

# CrowdSec Traefik bouncer (shared with LAPI via BOUNCER_KEY_traefik)
# openssl rand -hex 32
CROWDSEC_BOUNCER_KEY=CHANGE_ME_openssl_rand_hex_32
